<Window x:Class="MultimeterDisplay.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="UNI-T E61+ Multimeter Display" Height="750" Width="1000" 
        Closed="Window_Closed" Background="#1e1e1e" FontFamily="Segoe UI">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Background="#252526" Padding="20">
            <TextBlock Text="UNI-T E61+ Multimeter Display" FontSize="28" FontWeight="Bold" Foreground="White"/>
            <TextBlock Text="Real-time multimeter data logger and analyzer" FontSize="12" Foreground="#b4b4b4" Margin="0,5,0,0"/>
        </StackPanel>

        <!-- Main Content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>

            <!-- Left Panel - Display and Chart -->
            <StackPanel Grid.Column="0" Orientation="Vertical" Padding="20" Spacing="15">
                <!-- Current Reading Display -->
                <Border Background="#2d2d30" CornerRadius="8" Padding="20" BorderThickness="1" BorderBrush="#3e3e42">
                    <StackPanel Orientation="Vertical" Spacing="10">
                        <TextBlock Text="Current Reading" Foreground="#d4d4d4" FontSize="12" FontWeight="Bold"/>
                        <TextBlock Name="ReadingText" Text="Waiting for connection..." FontSize="72" FontWeight="Bold" 
                                   Foreground="#7fdbca" TextAlignment="Center" FontFamily="Courier New" MinHeight="100"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="30">
                            <StackPanel Orientation="Vertical" Spacing="5">
                                <TextBlock Text="Mode:" Foreground="#b4b4b4" FontSize="11"/>
                                <TextBlock Name="ModeText" Text="---" Foreground="#7fdbca" FontSize="14" FontWeight="Bold"/>
                            </StackPanel>
                            <StackPanel Orientation="Vertical" Spacing="5">
                                <TextBlock Text="Unit:" Foreground="#b4b4b4" FontSize="11"/>
                                <TextBlock Name="UnitText" Text="---" Foreground="#7fdbca" FontSize="14" FontWeight="Bold"/>
                            </StackPanel>
                            <StackPanel Orientation="Vertical" Spacing="5">
                                <TextBlock Text="Range:" Foreground="#b4b4b4" FontSize="11"/>
                                <TextBlock Name="RangeText" Text="---" Foreground="#7fdbca" FontSize="14" FontWeight="Bold"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Statistics Panel -->
                <Border Background="#2d2d30" CornerRadius="8" Padding="20" BorderThickness="1" BorderBrush="#3e3e42">
                    <StackPanel Orientation="Vertical" Spacing="10">
                        <TextBlock Text="Statistics" Foreground="#d4d4d4" FontSize="12" FontWeight="Bold"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Vertical" Spacing="5">
                                <TextBlock Text="MIN" Foreground="#b4b4b4" FontSize="11"/>
                                <TextBlock Name="MinValueText" Text="---" Foreground="#4ec9b0" FontSize="14" FontWeight="Bold"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Vertical" Spacing="5">
                                <TextBlock Text="AVG" Foreground="#b4b4b4" FontSize="11"/>
                                <TextBlock Name="AvgValueText" Text="---" Foreground="#4ec9b0" FontSize="14" FontWeight="Bold"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Vertical" Spacing="5">
                                <TextBlock Text="MAX" Foreground="#b4b4b4" FontSize="11"/>
                                <TextBlock Name="MaxValueText" Text="---" Foreground="#4ec9b0" FontSize="14" FontWeight="Bold"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock Name="SampleCountText" Text="Samples: 0" Foreground="#808080" FontSize="11" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Data Log Panel -->
                <Border Background="#2d2d30" CornerRadius="8" Padding="20" BorderThickness="1" BorderBrush="#3e3e42" Height="200">
                    <StackPanel Orientation="Vertical" Spacing="10">
                        <TextBlock Text="Recent Readings" Foreground="#d4d4d4" FontSize="12" FontWeight="Bold"/>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ListBox Name="ReadingsList" Background="Transparent" BorderThickness="0" Foreground="#d4d4d4" FontFamily="Courier New" FontSize="11"/>
                        </ScrollViewer>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Right Panel - Controls -->
            <StackPanel Grid.Column="1" Orientation="Vertical" Padding="20" Spacing="15">
                <!-- Connection Panel -->
                <Border Background="#2d2d30" CornerRadius="8" Padding="15" BorderThickness="1" BorderBrush="#3e3e42">
                    <StackPanel Orientation="Vertical" Spacing="12">
                        <TextBlock Text="Connection" Foreground="#d4d4d4" FontSize="12" FontWeight="Bold"/>
                        
                        <StackPanel Orientation="Vertical" Spacing="5">
                            <TextBlock Text="COM Port:" Foreground="#b4b4b4" FontSize="11"/>
                            <ComboBox Name="PortComboBox" Height="32" FontSize="11" Padding="8" Background="#3c3c3c" Foreground="#d4d4d4" BorderBrush="#3e3e42"/>
                        </StackPanel>

                        <StackPanel Orientation="Vertical" Spacing="5">
                            <TextBlock Text="Baud Rate:" Foreground="#b4b4b4" FontSize="11"/>
                            <ComboBox Name="BaudRateComboBox" Height="32" FontSize="11" Padding="8" Background="#3c3c3c" Foreground="#d4d4d4" BorderBrush="#3e3e42">
                                <ComboBoxItem>9600</ComboBoxItem>
                                <ComboBoxItem Selected="True">19200</ComboBoxItem>
                                <ComboBoxItem>38400</ComboBoxItem>
                                <ComboBoxItem>57600</ComboBoxItem>
                                <ComboBoxItem>115200</ComboBoxItem>
                            </ComboBox>
                        </StackPanel>

                        <Button Name="RefreshBtn" Content="🔄 Refresh Ports" Click="Refresh_Click" Height="32" FontSize="11" 
                                Background="#0078d4" Foreground="White" Cursor="Hand" FontWeight="SemiBold"/>
                        
                        <Button Name="ConnectBtn" Content="✓ Connect" Click="Connect_Click" Height="32" FontSize="11" 
                                Background="#107c10" Foreground="White" Cursor="Hand" FontWeight="SemiBold"/>
                        
                        <Button Name="DisconnectBtn" Content="✕ Disconnect" Click="Disconnect_Click" Height="32" FontSize="11" 
                                Background="#d83b01" Foreground="White" Cursor="Hand" FontWeight="SemiBold" IsEnabled="False"/>

                        <TextBlock Name="StatusText" Text="Ready" FontSize="11" Foreground="#d0d0d0" TextAlignment="Center" Padding="10"/>
                    </StackPanel>
                </Border>

                <!-- Recording Panel -->
                <Border Background="#2d2d30" CornerRadius="8" Padding="15" BorderThickness="1" BorderBrush="#3e3e42">
                    <StackPanel Orientation="Vertical" Spacing="12">
                        <TextBlock Text="Data Logging" Foreground="#d4d4d4" FontSize="12" FontWeight="Bold"/>
                        
                        <Button Name="StartLoggingBtn" Content="⚫ Start Recording" Click="StartLogging_Click" Height="32" FontSize="11" 
                                Background="#8c5fbf" Foreground="White" Cursor="Hand" FontWeight="SemiBold" IsEnabled="False"/>
                        
                        <Button Name="StopLoggingBtn" Content="⏹ Stop Recording" Click="StopLogging_Click" Height="32" FontSize="11" 
                                Background="#8c5fbf" Foreground="White" Cursor="Hand" FontWeight="SemiBold" IsEnabled="False"/>

                        <TextBlock Name="RecordingStatusText" Text="Not recording" FontSize="11" Foreground="#b4b4b4" TextAlignment="Center" Padding="8"/>

                        <Button Name="ExportBtn" Content="💾 Export to CSV" Click="Export_Click" Height="32" FontSize="11" 
                                Background="#0078d4" Foreground="White" Cursor="Hand" FontWeight="SemiBold" IsEnabled="False"/>

                        <Button Name="ClearBtn" Content="🗑 Clear Data" Click="Clear_Click" Height="32" FontSize="11" 
                                Background="#d83b01" Foreground="White" Cursor="Hand" FontWeight="SemiBold" IsEnabled="False"/>
                    </StackPanel>
                </Border>

                <!-- Settings Panel -->
                <Border Background="#2d2d30" CornerRadius="8" Padding="15" BorderThickness="1" BorderBrush="#3e3e42">
                    <StackPanel Orientation="Vertical" Spacing="12">
                        <TextBlock Text="Settings" Foreground="#d4d4d4" FontSize="12" FontWeight="Bold"/>
                        
                        <CheckBox Name="AutoReconnectCheckBox" Content="Auto-reconnect" Foreground="#d4d4d4" FontSize="11" IsChecked="True"/>
                        
                        <CheckBox Name="AutoExportCheckBox" Content="Auto-save every 100 samples" Foreground="#d4d4d4" FontSize="11" IsChecked="False"/>

                        <StackPanel Orientation="Vertical" Spacing="5">
                            <TextBlock Text="Display Refresh (ms):" Foreground="#b4b4b4" FontSize="11"/>
                            <TextBox Name="RefreshRateTextBox" Text="500" Height="28" FontSize="11" Padding="8" Background="#3c3c3c" Foreground="#d4d4d4" BorderBrush="#3e3e42"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <!-- Footer - Status Bar -->
        <Border Grid.Row="2" Background="#252526" BorderThickness="0,1,0,0" BorderBrush="#3e3e42" Padding="15">
            <StackPanel Orientation="Horizontal" Spacing="20">
                <StackPanel Orientation="Horizontal" Spacing="5">
                    <TextBlock Text="●" Foreground="#d0d0d0" FontSize="12"/>
                    <TextBlock Name="ConnectionIndicator" Text="Disconnected" Foreground="#d0d0d0" FontSize="11"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="5">
                    <TextBlock Text="Elapsed:" Foreground="#b4b4b4" FontSize="11"/>
                    <TextBlock Name="ElapsedTimeText" Text="00:00:00" Foreground="#d0d0d0" FontSize="11" FontFamily="Courier New"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="5">
                    <TextBlock Text="Version:" Foreground="#b4b4b4" FontSize="11"/>
                    <TextBlock Text="1.0.0" Foreground="#d0d0d0" FontSize="11"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
