<Window x:Class="MultimeterDisplay.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Multimeter Display" Height="350" Width="700" Closed="Window_Closed" Background="#1e1e1e">
    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="25">
        <TextBlock Text="UNI-T UT161E Display" FontSize="28" FontWeight="Bold" TextAlignment="Center" Foreground="White"/>
        
        <TextBlock Name="ReadingText" Text="Waiting for connection..." FontSize="80" FontWeight="Bold" Foreground="Lime" TextAlignment="Center" FontFamily="Courier New"/>
        
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="15">
            <TextBlock Text="COM Port:" VerticalAlignment="Center" Foreground="White" FontSize="14"/>
            <ComboBox Name="PortComboBox" Width="120" Height="35" FontSize="12" Padding="8,8"/>
            
            <Button Name="RefreshBtn" Content="Refresh Ports" Click="Refresh_Click" Width="120" Height="35" FontSize="12" Background="#0078d4" Foreground="White" Cursor="Hand"/>
            
            <Button Name="ConnectBtn" Content="Connect" Click="Connect_Click" Width="100" Height="35" FontSize="12" Background="#107c10" Foreground="White" Cursor="Hand"/>
            
            <Button Name="DisconnectBtn" Content="Disconnect" Click="Disconnect_Click" Width="120" Height="35" FontSize="12" Background="#d83b01" Foreground="White" Cursor="Hand" IsEnabled="False"/>
        </StackPanel>
        
        <TextBlock Name="StatusText" Text="Ready - Select COM port and click Connect" FontSize="14" Foreground="#d0d0d0" TextAlignment="Center" Padding="10"/>
    </StackPanel>
</Window>